# Copy this file to .env.local and fill in your values. .env.local is gitignored.
# These are SERVER-SIDE ONLY — do NOT prefix with VITE_ (that would expose them
# to the browser bundle). They are read by the Vite dev middleware in server/.

# Your Nebius Token Factory API key.
NEBIUS_API_KEY=

# The model to run as the model-under-test, e.g.:
#   meta-llama/Meta-Llama-3.1-70B-Instruct
#   Qwen/Qwen2.5-72B-Instruct
#   deepseek-ai/DeepSeek-V3
NEBIUS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# Optional. Defaults to https://api.studio.nebius.com/v1 (OpenAI-compatible).
# NEBIUS_BASE_URL=https://api.studio.nebius.com/v1
